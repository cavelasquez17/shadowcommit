# ShadowCommit — environment variables
# Copy this file to .env and fill in your values.
# The API reads these via os.Getenv — no .env loader needed if you export them.

# --- Server ---
PORT=8080
APP_ENV=development
APP_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:5173

# --- Database ---
DB_DRIVER=sqlite
DATABASE_URL=shadowcommit.db

# --- Security ---
# Generate a random 32+ char string: openssl rand -hex 32
JWT_SECRET=dev-secret-rotate-me-or-get-fired

# --- GitHub OAuth ---
# Create at: https://github.com/settings/applications/new
# Callback URL: http://localhost:8080/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Background jobs ---
# Daily 03:00 hot-score refresh and Monday 09:00 weekly digest (server local time).
# Set to false on every replica but one.
JOBS_ENABLED=true

# --- Feature flags ---
DEV_LOGIN=true
INVITE_ONLY=false

# --- CORS (comma-separated) ---
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
