# Never let secrets, local data or build output into the build context.
.git
.github
.env
.env.*
!.env.example
**/.env
**/*.db
**/*.db-journal
**/*.db-wal
**/*.db-shm

# Dependencies and build output are rebuilt inside the image.
**/node_modules
web/dist
api/shadowcommit
api/api

# Not needed to build or run.
.screens
*.md
!api/**/*.md
LICENSE
.vscode
.idea
.DS_Store
