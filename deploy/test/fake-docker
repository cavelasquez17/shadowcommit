#!/usr/bin/env bash
# A tiny stand-in for the docker CLI, driven by files in $FAKE_DIR, so deploy/update.sh can be
# tested without Docker or a registry.
#   registry_image   image id the registry currently serves (what `pull` fetches)
#   pulled_image     image id present locally after a pull
#   running_image    image id the app container runs (absent = no container)
#   health_<id>      health status of a container running that image (default: healthy)
#   revision         value of the org.opencontainers.image.revision label
#   tag_<name>       image id a local tag points at (created by `docker tag`)
#   pruned_<id>      marks an image id that `docker image prune` has deleted
# FAKE_PULL_FAILS=1 makes `compose pull` fail, as when the registry is unreachable.
# FAKE_UP_FAILS=1 makes an unpinned `compose up` fail without changing what runs.
# FAKE_PRUNE_OLD=1 makes `compose pull` simulate the previous image becoming untagged and pruned.
set -euo pipefail
echo "$*" >> "$FAKE_DIR/calls"
read_file() { [ -f "$FAKE_DIR/$1" ] && cat "$FAKE_DIR/$1"; }

case "$1" in
  inspect)
    case "$3" in
      '{{.Image}}') read_file running_image || exit 1 ;;
      '{{.State.Health.Status}}')
        id=$(read_file running_image) || { echo missing; exit 1; }
        read_file "health_$id" || echo healthy ;;
      *) exit 1 ;;
    esac ;;
  image)
    case "$4" in
      '{{.Id}}') read_file pulled_image ;;
      *revision*) read_file revision || true ;;
      *) exit 1 ;;
    esac ;;
  tag) echo "$2" > "$FAKE_DIR/tag_$3" ;;
  exec)
    # exec <container> /app/shadowcommit -backup <file>: the backup step. FAKE_BACKUP_FAILS=1 fails it.
    if [ -n "${FAKE_BACKUP_FAILS:-}" ]; then echo "backup failed" >&2; exit 1; fi
    exit 0 ;;
  compose)
    shift
    case "$1" in
      pull)
        if [ -n "${FAKE_PULL_FAILS:-}" ]; then echo "registry unreachable" >&2; exit 1; fi
        # The previous image loses its tag when :main moves; a prune may then delete it.
        if [ -n "${FAKE_PRUNE_OLD:-}" ] && [ -f "$FAKE_DIR/running_image" ]; then touch "$FAKE_DIR/pruned_$(cat "$FAKE_DIR/running_image")"; fi
        cp "$FAKE_DIR/registry_image" "$FAKE_DIR/pulled_image" ;;
      up)
        wait=""; for arg in "$@"; do [ "$arg" = "--wait" ] && wait=1; done
        pin="${SHADOWCOMMIT_IMAGE:-}"
        if [ -z "$pin" ] && [ -n "${FAKE_UP_FAILS:-}" ]; then echo "up failed" >&2; exit 1
        elif [ -z "$pin" ]; then cp "$FAKE_DIR/pulled_image" "$FAKE_DIR/running_image"
        elif [ -f "$FAKE_DIR/tag_$pin" ]; then cat "$FAKE_DIR/tag_$pin" > "$FAKE_DIR/running_image" # a tag keeps its image alive
        elif [ -f "$FAKE_DIR/pruned_$pin" ]; then echo "image $pin was pruned" >&2; exit 1
        else echo "$pin" > "$FAKE_DIR/running_image"; fi
        # With --wait, compose fails when the container it just started is not healthy.
        if [ -n "$wait" ] && [ "$(cat "$FAKE_DIR/health_$(cat "$FAKE_DIR/running_image")" 2>/dev/null || echo healthy)" != healthy ]; then
          echo "container is unhealthy" >&2; exit 1
        fi ;;
      *) exit 1 ;;
    esac ;;
  *) exit 1 ;;
esac
