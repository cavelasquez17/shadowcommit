# Copy to .env on the host and fill in the values. Never commit the real file.

# Public host name, for example <your-subdomain>.duckdns.org
SHADOWCOMMIT_DOMAIN=

# The public origin, with https:// and no trailing slash. These must match the domain above and
# the callback URL of the GitHub OAuth app.
APP_BASE_URL=
WEB_BASE_URL=
CORS_ORIGINS=

# Generate with: openssl rand -hex 32
JWT_SECRET=

# From the GitHub OAuth app (Settings -> Developer settings -> OAuth Apps).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# DEV_LOGIN must stay off in production (the app refuses to start otherwise).
INVITE_ONLY=true
