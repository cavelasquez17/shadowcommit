# Copy to .env on the host and fill in the values. Never commit the real file.

# Public host name, for example <your-subdomain>.duckdns.org
SHADOWCOMMIT_DOMAIN=

# The app's APP_BASE_URL, WEB_BASE_URL and CORS_ORIGINS are derived from this host name by
# docker-compose.yml (https://<host>), so there is only one value to get right.

# Generate with: openssl rand -hex 32
JWT_SECRET=

# From the GitHub OAuth app (Settings -> Developer settings -> OAuth Apps).
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# DEV_LOGIN must stay off in production (the app refuses to start otherwise).
INVITE_ONLY=true
